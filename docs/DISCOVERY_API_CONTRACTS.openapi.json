{
  "openapi": "3.1.0",
  "info": {
    "title": "CASA discovery V1 contracts",
    "version": "1"
  },
  "paths": {
    "/api/discoveries/{discovery_key}/links": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Discovery Links",
        "operationId": "discovery_links_api_discoveries__discovery_key__links_get",
        "parameters": [
          {
            "name": "discovery_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Discovery Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryLinksOut"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "404": {
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "description": "Erreur interne non stockable, sans détail privé",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/knowledge-nodes": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Admin Knowledge Nodes",
        "operationId": "admin_knowledge_nodes_api_admin_knowledge_nodes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKnowledgeNodePage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/lessons/{lesson_id}/knowledge-nodes": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Lesson Knowledge Nodes",
        "operationId": "lesson_knowledge_nodes_api_admin_lessons__lesson_id__knowledge_nodes_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lesson Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonKnowledgeNodesOut"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "discovery"
        ],
        "summary": "Replace Lesson Knowledge Nodes",
        "operationId": "replace_lesson_knowledge_nodes_api_admin_lessons__lesson_id__knowledge_nodes_put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lesson_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Lesson Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LessonKnowledgeNodesReplacement"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonKnowledgeNodesOut"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryErrorOut"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation du corps ou notion inexistante, sans mutation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminKnowledgeNodeOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "title": "AdminKnowledgeNodeOut"
      },
      "AdminKnowledgeNodePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdminKnowledgeNodeOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "AdminKnowledgeNodePage"
      },
      "ContentStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "PUBLISHED",
          "ARCHIVED"
        ],
        "title": "ContentStatus"
      },
      "DiscoveryCourseOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "school_id": {
            "type": "string",
            "title": "School Id"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "duration_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Min"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "school_id",
          "level",
          "duration_min"
        ],
        "title": "DiscoveryCourseOut"
      },
      "DiscoveryErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "DiscoveryErrorOut"
      },
      "DiscoveryLinksOut": {
        "properties": {
          "discovery_key": {
            "type": "string",
            "const": "llm-answer",
            "title": "Discovery Key"
          },
          "registry_version": {
            "type": "integer",
            "const": 1,
            "title": "Registry Version"
          },
          "scenes": {
            "items": {
              "$ref": "#/components/schemas/DiscoverySceneOut"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 6,
            "title": "Scenes"
          },
          "notions": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryNotionOut"
            },
            "type": "array",
            "title": "Notions"
          },
          "courses": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryCourseOut"
            },
            "type": "array",
            "title": "Courses"
          }
        },
        "type": "object",
        "required": [
          "discovery_key",
          "registry_version",
          "scenes",
          "notions",
          "courses"
        ],
        "title": "DiscoveryLinksOut"
      },
      "DiscoveryNotionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "DiscoveryNotionOut"
      },
      "DiscoverySceneOut": {
        "properties": {
          "scene_key": {
            "type": "string",
            "title": "Scene Key"
          },
          "notion_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notion Ids"
          },
          "course_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Course Ids"
          }
        },
        "type": "object",
        "required": [
          "scene_key",
          "notion_ids",
          "course_ids"
        ],
        "title": "DiscoverySceneOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LessonKnowledgeNodesOut": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "node_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Node Ids"
          },
          "revision": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Revision"
          }
        },
        "type": "object",
        "required": [
          "lesson_id",
          "node_ids",
          "revision"
        ],
        "title": "LessonKnowledgeNodesOut"
      },
      "LessonKnowledgeNodesReplacement": {
        "properties": {
          "node_ids": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "title": "Node Ids"
          },
          "expected_revision": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "node_ids",
          "expected_revision"
        ],
        "title": "LessonKnowledgeNodesReplacement"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
